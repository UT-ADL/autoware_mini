<?xml version="1.0"?>
<launch>
    
    <!-- Map configuration -->
    <arg name='map_name'                default='tartu_demo'                   doc="Map name to use"/>

    <!-- Vehicle-in-the-loop -->
    <arg name="use_vil"                 default="false"                        doc="Run vehicle-in-the-loop: Carla provides the world and sensors, ego pose/velocity is propagated to Carla"/>
    <arg name="carla_host"               default="localhost"                    doc="Carla server host"/>
    <arg name="carla_port"              default="2000"                         doc="Carla server port"/>

    <!-- Autonomy options -->
    <arg name="use_tf"                  default="true"                         doc="Replace tf-s in bag with the current ones"/>
    <arg name="use_localization"        default="$(arg use_tf)"                doc="Replace localization topics"/>
    <arg name="use_perception"           default="true"                         doc="Replace perception topics"/>
    <arg name="use_planning"            default="true"                         doc="Replace planning topics"/>
    <arg name="use_control"             default="true"                         doc="Replace control topics"/>
    <arg name="repub_camera_info"       default="false"                        doc="Republish camera_info topics using camera intrinsics files"/>

    <!-- Benchmarking -->
    <arg name="benchmark_topic"         default=""                             doc="Name of the topic to benchmark"/>
    <arg name="benchmark_type"          default="delay"                        doc="Type of benchmark, e.g. delay or hz"/>

    <!-- Recording options -->
    <arg name="record_bag"              default=""                             doc="Name of the bag to record"/>
    <arg name="record_topics"           default="(/perception/detected_objects|/perception/traffic_light_status|/localization/current_pose|/localization/current_velocity|/tf)" doc="Regexp of the topics to record, 'all' to record all"/>
    <arg name="record_topics_option"    default="$(eval '--all' if record_topics == 'all' else '--regex ' + record_topics if record_topics != '' else '')" doc="Rosbag record parameter"/>

    <!-- Playback options -->
    <arg name="bag_file"                default="2023-05-25-14-21-10_sensors_Raekoda.bag" doc="Bag file to play"/>
    <arg name="bag_folder"              default="$(find autoware_mini)/data/bags" doc="Folder where the bag_file is located"/>
    <arg name="bag_delay"               default="$(eval '30' if use_vil else '6')" doc="Delay before starting to publish messages"/>
    <arg name="loop"                    default="$(eval benchmark_topic == '' and record_bag == '')" doc="Loop bag playback"/>
    <arg name="loop_option"             default="$(eval '--loop' if loop else '')" doc="Rosbag play parameter"/>
    <arg name="start"                   default=""                             doc="Seconds from the start of the bag"/>
    <arg name="start_option"            default="$(eval '--start ' + str(start) if start != '' else '')" doc="Rosbag play parameter"/>
    <arg name="duration"                default=""                             doc="Seconds to play from start"/>
    <arg name="duration_option"         default="$(eval '--duration ' + str(duration) if duration != '' else '')" doc="Rosbag play parameter"/>
    <arg name="rate"                    default=""                             doc="Bag speed parameter, defaults to 1.0 i.e. the normal speed"/>
    <arg name="rate_option"             default="$(eval '--rate ' + str(rate) if rate != '' else '')" doc="Rosbag play parameter"/>
    
    <!-- Localization -->
    <arg name="localizer"               default="novatel"                      doc="Localizer to use (novatel, carla)"/>
    <arg name="use_lane_matching"       default="false"                        doc="Enable lane boundary matching for localization"/>
    <arg name="time_source"             default="auto"                         doc="Time source for novatel localizer: ros, gps, or auto"/>
    
    <!-- Detection -->
    <arg name="detector"                default="$(eval 'carla' if use_vil else 'lidar_cluster')" doc="Detector to use (lidar_cluster, lidar_cluster_gpu, sim, carla)"/>
    <arg name="use_lidar_center"        default="true"                         doc="Use Velodyne lidar"/>
    <arg name="use_lidar_front"         default="false"                        doc="Use Ouster lidar"/>
    <arg name="use_road_area_filter"    default="$(eval 'tartu' in map_name)"  doc="Use road area filter"/>
    <arg name="ground_removal"          default="naive"                        doc="Ground removal method (naive, jcp)"/>
    <arg name="tfl_detector"            default="$(eval 'carla' if use_vil else 'yolo')" doc="Traffic light detector to use (yolo, camera, mqtt, mqtt_yolo_fusion, mqtt_camera_fusion)"/>
    <arg name="tfl_cameras"             default="mako"                         doc="Cameras to use for traffic light detection (mako, nvidia)"/>
    <arg name="use_nvidia_cameras"      default="$(eval ('camera' in tfl_detector or 'yolo' in tfl_detector) and tfl_cameras=='nvidia')" doc="Use nvidia cameras"/>
    <arg name="nvidia_encoder"          default="$(eval 'jpeg' if ('camera' in tfl_detector or 'yolo' in tfl_detector) and tfl_cameras=='nvidia' else 'h264')" doc="Nvidia camera encoder (h264, jpeg)"/>
    <arg name="tracker"                 default="$(eval 'none' if detector == 'radar' else 'ema')" doc="Tracker to use (none, ema)"/>
    <arg name="predictor"               default="map_naive"                    doc="Predictor to use (none, naive, map, map_naive)"/>
    <arg name="use_ignored_objects_filter" default="true"                      doc="Enable filter that suppresses operator-selected objects from tracked_objects"/>
    <arg name="detection_range"         default=""                             doc="Detection range in meters (empty for default)"/>
    <arg name="more_visualizations"     default="true"                         doc="When debugging a bag, visualize everything by default"/>
    
    <!-- Planning -->
    <arg name="global_planner"          default="lanelet2"                     doc="Global planner to use (waypoints, lanelet2)"/>
    <arg name="local_planner"           default="rule_swerve"                  doc="Local planner to use (rule_speed, rule_swerve, openpilot, none)"/>
    <arg name="use_path_smoothing"      default="true"                         doc="Enable path smoothing"/>
    <arg name="enable_goal_checker"          default="true"                    doc="Enable goal checker"/>
    <arg name="enable_object_checker"        default="true"                    doc="Enable object checker"/>
    <arg name="enable_manual_yield_checker"  default="true"                    doc="Enable auto stop checker"/>
    <arg name="enable_stop_sign_checker"      default="true"                    doc="Enable stop sign checker"/>
    <arg name="enable_traffic_light_checker" default="true"                    doc="Enable traffic light checker"/>
    <arg name="enable_crosswalk_checker"     default="true"                    doc="Enable crosswalk checker"/>
    <arg name="enable_yielding_checker"      default="true"                    doc="Enable yielding checker"/>
    <arg name="enable_give_way_checker"      default="true"                    doc="Enable give way checker"/>
    <arg name="enable_right_of_way_checker"  default="true"                    doc="Enable right of way checker"/>
    <arg name="enable_trajectory_checker"    default="true"                    doc="Enable trajectory checker"/>
    <arg name="enable_bus_stop_checker"      default="true"                    doc="Enable bus stop checker"/>
    <arg name="enable_road_closures"    default="false"                        doc="Enable road closures"/>

    <!-- Control -->
    <arg name="controller"              default="pure_pursuit"                 doc="Controller to use (pure_pursuit, stanley)"/>

    <!-- Visualization -->
    <arg name="launch_rviz"             default="true"                         doc="Determines if rviz is launched or not"/>
    <arg name="use_python_visualizers"  default="true"                         doc="Use Python visualizer nodes instead of RViz plugins"/>

    <!-- Monitoring -->
    <arg name='use_monitoring'          default='false'                        doc="Determines the usage of monitoring nodes."/>
    <arg name='use_driver_monitoring'   default='false'                        doc="Determines the usage of driver monitoring nodes."/>
    <arg name='use_bag_diagnostics'     default='false'                        doc="Determines the usage of bag diagnostics."/>

    <!-- Use simulation time from bag -->
    <param name="/use_sim_time" value="true" />

    <!-- Play back bag -->
    <node pkg="rosbag" type="play" name="player" required="true" output="screen"
            args="$(arg bag_folder)/$(arg bag_file) --clock --quiet --queue=1 --delay $(arg bag_delay) $(arg loop_option) $(arg start_option) $(arg duration_option) $(arg rate_option)">
        <!-- Rename saved topics that are replaced by current ones -->
        <remap from="/tf" to="/bag/tf" if="$(arg use_tf)"/>
        <remap from="/tf_static" to="/bag/tf_static" if="$(arg use_tf)"/>
        <remap from="/localization/current_pose" to="/bag/localization/current_pose" if="$(arg use_localization)"/>
        <remap from="/localization/current_velocity" to="/bag/localization/current_velocity" if="$(arg use_localization)"/>
        <remap from="/localization/odometry" to="/bag/localization/odometry" if="$(arg use_localization)"/>
        <remap from="/localization/lane_boundary_matcher_markers" to="/bag/localization/lane_boundary_matcher_markers" if="$(arg use_lane_matching)"/>
        <remap from="/perception/lidar/points_ground" to="/bag/perception/lidar/points_ground" if="$(arg use_perception)"/>
        <remap from="/perception/lidar/center/points_no_ground" to="/bag/perception/lidar/center/points_no_ground" if="$(arg use_perception)"/>
        <remap from="/perception/lidar/front/points_no_ground" to="/bag/perception/lidar/front/points_no_ground" if="$(arg use_perception)"/>
        <remap from="/perception/lidar/points_no_ground" to="/bag/perception/lidar/points_no_ground" if="$(arg use_perception)"/>
        <remap from="/perception/lidar/points_clustered" to="/bag/perception/lidar/points_clustered" if="$(arg use_perception)"/>
        <remap from="/perception/lidar/points_filtered" to="/bag/perception/lidar/points_filtered" if="$(arg use_perception)"/>
        <remap from="/perception/lidar/detected_objects" to="/bag/perception/lidar/detected_objects" if="$(arg use_perception)"/>
        <remap from="/perception/lidar/detected_objects_markers" to="/bag/perception/lidar/detected_objects_markers" if="$(arg use_perception)"/>
        <remap from="/perception/radar/detected_objects" to="/bag/perception/radar/detected_objects" if="$(arg use_perception)"/>
        <remap from="/perception/radar/detected_objects_markers" to="/bag/perception/radar/detected_objects_markers" if="$(arg use_perception)"/>
        <remap from="/perception/detected_objects" to="/bag/perception/detected_objects" if="$(arg use_perception)"/>
        <remap from="/perception/detected_objects_markers" to="/bag/perception/detected_objects_markers" if="$(arg use_perception)"/>
        <remap from="/perception/detected_objects_filtered" to="/bag/perception/detected_objects_filtered" if="$(arg use_perception)"/>
        <remap from="/perception/detected_objects_range_filtered" to="/bag/perception/detected_objects_range_filtered" if="$(arg use_perception)"/>
        <remap from="/perception/road_area_markers" to="/bag/perception/road_area_markers" if="$(arg use_perception)"/>
        <remap from="/perception/tracked_objects" to="/bag/perception/tracked_objects" if="$(arg use_perception)"/>
        <remap from="/perception/tracked_objects_unfiltered" to="/bag/perception/tracked_objects_unfiltered" if="$(arg use_perception)"/>
        <remap from="/perception/tracked_objects_markers" to="/bag/perception/tracked_objects_markers" if="$(arg use_perception)"/>
        <remap from="/perception/ignored_objects_markers" to="/bag/perception/ignored_objects_markers" if="$(arg use_perception)"/>
        <remap from="/perception/predicted_objects_map" to="/bag/perception/predicted_objects_map" if="$(arg use_perception)"/>
        <remap from="/perception/predicted_objects" to="/bag/perception/predicted_objects" if="$(arg use_perception)"/>
        <remap from="/perception/predicted_objects_markers" to="/bag/perception/predicted_objects_markers" if="$(arg use_perception)"/>
        <remap from="/perception/final_objects" to="/bag/perception/final_objects" if="$(arg use_perception)"/>
        <remap from="/perception/final_objects_markers" to="/bag/perception/final_objects_markers" if="$(arg use_perception)"/>
        <remap from="/lidar_front/points_cleaned" to="/bag/lidar_front/points_cleaned" if="$(arg use_perception)"/>
        <remap from="/planning/lanelet2_map_markers" to="/bag/planning/lanelet2_map_markers" if="$(arg use_planning)"/>
        <remap from="/planning/lanelet2_global_path" to="/bag/planning/lanelet2_global_path" if="$(arg use_planning)"/>
        <remap from="/planning/lanelet2_global_path_markers" to="/bag/planning/lanelet2_global_path_markers" if="$(arg use_planning)"/>
        <remap from="/planning/lane_change_global_path" to="/bag/planning/lane_change_global_path" if="$(arg use_planning)"/>
        <remap from="/planning/lane_change_global_path_markers" to="/bag/planning/lane_change_global_path_markers" if="$(arg use_planning)"/>
        <remap from="/planning/global_path" to="/bag/planning/global_path" if="$(arg use_planning)"/>
        <remap from="/planning/global_path_markers" to="/bag/planning/global_path_markers" if="$(arg use_planning)"/>
        <remap from="/planning/extracted_local_path" to="/bag/planning/extracted_local_path" if="$(arg use_planning)"/>
        <remap from="/planning/local_path" to="/bag/planning/local_path" if="$(arg use_planning)"/>
        <remap from="/planning/extracted_local_path" to="/bag/planning/extracted_local_path" if="$(arg use_planning)"/>
        <remap from="/planning/collision_points" to="/bag/planning/collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/local_path_markers" to="/bag/planning/local_path_markers" if="$(arg use_planning)"/>
        <remap from="/planning/lane_boundary_safety_box_markers" to="/bag/planning/lane_boundary_safety_box_markers" if="$(arg use_planning)"/>
        <remap from="/planning/target_lane_markers" to="/bag/planning/target_lane_markers" if="$(arg use_planning)"/>
        <remap from="/planning/goal_collision_points" to="/bag/planning/goal_collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/object_collision_points" to="/bag/planning/object_collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/yielding_collision_points" to="/bag/planning/yielding_collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/give_way_collision_points" to="/bag/planning/give_way_collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/right_of_way_collision_points" to="/bag/planning/right_of_way_collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/bus_stop_collision_points" to="/bag/planning/bus_stop_collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/crosswalk_collision_points" to="/bag/planning/crosswalk_collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/tfl_stop_line_collision_points" to="/bag/planning/tfl_stop_line_collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/stop_line_collision_points" to="/bag/planning/stop_line_collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/trajectory_collision_points" to="/bag/planning/trajectory_collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/collision_points" to="/bag/planning/collision_points" if="$(arg use_planning)"/>
        <remap from="/planning/stop_line_status" to="/bag/planning/stop_line_status" if="$(arg use_perception)"/>
        <remap from="/planning/stop_line_status_markers" to="/bag/planning/stop_line_status_markers" if="$(arg use_perception)"/>
        <remap from="/perception/traffic_light_status" to="/bag/perception/traffic_light_status" if="$(arg use_perception)"/>
        <remap from="/perception/camera_fl/traffic_light_status" to="/bag/perception/camera_fl/traffic_light_status" if="$(arg use_perception)"/>
        <remap from="/perception/camera_fl/traffic_light_roi" to="/bag/perception/camera_fl/traffic_light_roi" if="$(arg use_perception)"/>
        <remap from="/perception/camera_fr/traffic_light_status" to="/bag/perception/camera_fr/traffic_light_status" if="$(arg use_perception)"/>
        <remap from="/perception/camera_fr/traffic_light_roi" to="/bag/perception/camera_fr/traffic_light_roi" if="$(arg use_perception)"/>
        <remap from="/perception/camera1/traffic_light_status" to="/bag/perception/camera1/traffic_light_status" if="$(arg use_perception)"/>
        <remap from="/perception/camera1/traffic_light_roi" to="/bag/perception/camera1/traffic_light_roi" if="$(arg use_perception)"/>
        <remap from="/perception/camera2/traffic_light_status" to="/bag/perception/camera2/traffic_light_status" if="$(arg use_perception)"/>
        <remap from="/perception/camera2/traffic_light_roi" to="/bag/perception/camera2/traffic_light_roi" if="$(arg use_perception)"/>
        <remap from="/perception/camera/traffic_light_status" to="/bag/perception/camera/traffic_light_status" if="$(arg use_perception)"/>
        <remap from="/perception/mqtt/traffic_light_status" to="/bag/perception/mqtt/traffic_light_status" if="$(arg use_perception)"/>
        <remap from="/control/vehicle_cmd" to="/bag/control/vehicle_cmd" if="$(arg use_control)"/>
        <remap from="/vehicle/vehicle_status" to="/bag/vehicle/vehicle_status" if="$(arg use_control)"/>
        <remap from="/vehicle/teleop_enabled" to="/bag/vehicle/teleop_enabled" if="$(arg use_control)"/>
        <remap from="/ssc/arbitrated_speed_commands" to="/bag/ssc/arbitrated_speed_commands" if="$(arg use_control)"/>
        <remap from="/ssc/arbitrated_steering_commands" to="/bag/ssc/arbitrated_steering_commands" if="$(arg use_control)"/>
        <remap from="/ssc/turn_signal_command" to="/bag/ssc/turn_signal_command" if="$(arg use_control)"/>
        <remap from="/ssc/gear_select" to="/bag/ssc/gear_select" if="$(arg use_control)"/>
        <remap from="/dashboard/planner_status" to="/bag/dashboard/planner_status" if="$(eval use_perception or use_planning)" />
        <remap from="/dashboard/log_message" to="/bag/dashboard/log_message" if="$(eval use_perception or use_planning)" />
        <remap from="/dashboard/log_text" to="/bag/dashboard/log_text" if="$(eval use_perception or use_planning)" />
        <remap from="/dashboard/current_speed" to="/bag/dashboard/current_speed" />
        <remap from="/dashboard/target_speed" to="/bag/dashboard/target_speed" />
        <remap from="/dashboard/target_object_distance" to="/bag/dashboard/target_object_distance" />
        <remap from="/dashboard/target_object_speed" to="/bag/dashboard/target_object_speed" />
        <remap from="/dashboard/acceleration" to="/bag/dashboard/acceleration" />
        <remap from="/dashboard/acceleration_limit" to="/bag/dashboard/acceleration_limit" />
        <remap from="/dashboard/deceleration_limit" to="/bag/dashboard/deceleration_limit" />
        <remap from="/dashboard/gnss_corrections_detailed" to="/bag/dashboard/gnss_corrections_detailed" if="$(arg use_lane_matching)"/>
        <remap from="/dashboard/left_turn_status" to="/bag/dashboard/left_turn_status" />
        <remap from="/dashboard/right_turn_status" to="/bag/dashboard/right_turn_status" />
        <remap from="/dashboard/left_turn_command" to="/bag/dashboard/left_turn_command" />
        <remap from="/dashboard/right_turn_command" to="/bag/dashboard/right_turn_command" />
        <!-- For compatibility with older bags and Vella bags -->
        <remap from="/points_raw_center" to="/lidar_center/points_raw"/>
        <remap from="/points_raw_front" to="/lidar_front/points_raw"/>
        <remap from="/lidar_0/vlp32/pcl2" to="/lidar_center/points_raw"/>
        <remap from="/interfacea/link4/camera_info" to="/interfaceb/link0/camera_info"/>
        <remap from="/interfacea/link4/image/h264" to="/interfaceb/link0/image/h264"/>
        <remap from="/interfacea/link4/image/h265" to="/interfaceb/link0/image/h265"/>
        <remap from="/interfacea/link4/image/compressed" to="/interfaceb/link0/image/compressed"/>
        <!-- Remap camera_info's from bags to use different camera intrinsics -->
        <remap from="/camera_fl/camera_info" to="/bag/camera_fl/camera_info" if="$(arg repub_camera_info)"/>
        <remap from="/camera_fr/camera_info" to="/bag/camera_fr/camera_info" if="$(arg repub_camera_info)"/>
        <remap from="/interfacea/link0/camera_info" to="/bag/interfacea/link0/camera_info" if="$(arg repub_camera_info)"/>
        <remap from="/interfacea/link1/camera_info" to="/bag/interfacea/link1/camera_info" if="$(arg repub_camera_info)"/>
        <remap from="/interfacea/link2/camera_info" to="/bag/interfacea/link2/camera_info" if="$(arg repub_camera_info)"/>
        <remap from="/interfacea/link3/camera_info" to="/bag/interfacea/link3/camera_info" if="$(arg repub_camera_info)"/>
        <remap from="/interfaceb/link0/camera_info" to="/bag/interfaceb/link0/camera_info" if="$(arg repub_camera_info)"/>
        <!-- Remap monitoring topics -->
        <remap from="/statistics" to="/bag/statistics" if="$(arg use_monitoring)" />
        <remap from="/diagnostics" to="/bag/diagnostics" if="$(eval use_monitoring and not use_bag_diagnostics)" />
        <remap from="/dashboard/autonomy_overlay" to="/bag/dashboard/autonomy_overlay" if="$(arg use_monitoring)" />
        <remap from="/dashboard/diagnostics_overlay" to="/bag/dashboard/diagnostics_overlay" if="$(arg use_monitoring)" />
        <remap from="/dashboard/localization_detailed" to="/bag/dashboard/localization_detailed" if="$(arg use_monitoring)" />
        <remap from="/dashboard/local_planner_detailed" to="/bag/dashboard/local_planner_detailed" if="$(arg use_monitoring)" />
        <remap from="/dashboard/object_detection_detailed" to="/bag/dashboard/object_detection_detailed" if="$(arg use_monitoring)" />
        <remap from="/dashboard/traffic_lights_detailed" to="/bag/dashboard/traffic_lights_detailed" if="$(arg use_monitoring)" />
        <remap from="/dashboard/control_detailed" to="/bag/dashboard/control_detailed" if="$(arg use_monitoring)" />
        <remap from="/dashboard/gnss_detailed" to="/bag/dashboard/gnss_detailed" if="$(arg use_driver_monitoring)" />
        <remap from="/dashboard/pacmod_detailed" to="/bag/dashboard/pacmod_detailed" if="$(arg use_driver_monitoring)" />
        <remap from="/dashboard/ssc_detailed" to="/bag/dashboard/ssc_detailed" if="$(arg use_driver_monitoring)" />
        <remap from="/dashboard/cpu_detailed" to="/bag/dashboard/cpu_detailed" if="$(arg use_monitoring)" />
        <remap from="/dashboard/ram_detailed" to="/bag/dashboard/ram_detailed" if="$(arg use_monitoring)" />
    </node>

    <node if="$(eval benchmark_topic != '')" pkg="rostopic" type="rostopic" name="rostopic_benchmark" required="true" output="screen"
            args="$(arg benchmark_type) $(arg benchmark_topic)" />

    <node if="$(eval record_bag != '')" pkg="rosbag" type="record" name="recorder" required="true" output="screen"
            args="--output-name $(arg bag_folder)/$(arg record_bag) $(arg record_topics_option) --exclude '(/bag/.*|/clock)'" />

    <!-- Localization -->
    <include if="$(arg use_localization)" file="$(find autoware_mini)/launch/localization.launch">
        <arg name="localizer"           value="$(arg localizer)" />
        <arg name="map_name"            value="$(arg map_name)" />
        <arg name="broadcast_tf"        value="$(eval not use_vil)" />
        <arg name="use_lane_matching"   value="$(arg use_lane_matching)" />
        <arg name="time_source"         value="$(eval 'ros' if use_vil else time_source)" />
    </include>

    <!-- Perception -->
    <include if="$(arg use_perception)" file="$(find autoware_mini)/launch/perception.launch">
        <arg name="detector"            value="$(arg detector)" />
        <arg name="use_lidar_center"    value="$(arg use_lidar_center)" />
        <arg name="use_lidar_front"     value="$(arg use_lidar_front)" />
        <arg name="tfl_detector"        value="$(arg tfl_detector)" />
        <arg name="tfl_cameras"         value="$(arg tfl_cameras)" />
        <arg name="tracker"             value="$(arg tracker)" />
        <arg name="predictor"           value="$(arg predictor)" />
        <arg name="more_visualizations" value="$(arg more_visualizations)" />
        <arg name="detection_range"     value="$(arg detection_range)" />
        <arg name="map_name"            value="$(arg map_name)" />
        <arg name="use_road_area_filter" value="$(arg use_road_area_filter)" />
        <arg name="ground_removal"      value="$(arg ground_removal)" />
        <arg name="use_python_visualizers" value="$(arg use_python_visualizers)" />
        <arg name="use_ignored_objects_filter" value="$(arg use_ignored_objects_filter)" />
    </include>

    <!-- Planning -->
    <include if="$(arg use_planning)" file="$(find autoware_mini)/launch/planning.launch">
        <arg name="global_planner"      value="$(arg global_planner)" />
        <arg name="local_planner"       value="$(arg local_planner)" />
        <arg name="use_path_smoothing"  value="$(arg use_path_smoothing)" />
        <arg name="map_name"            value="$(arg map_name)" />
        <arg name="enable_goal_checker"          value="$(arg enable_goal_checker)" />
        <arg name="enable_object_checker"        value="$(arg enable_object_checker)" />
        <arg name="enable_manual_yield_checker"  value="$(arg enable_manual_yield_checker)" />
        <arg name="enable_stop_sign_checker"      value="$(arg enable_stop_sign_checker)" />
        <arg name="enable_traffic_light_checker" value="$(arg enable_traffic_light_checker)" />
        <arg name="enable_crosswalk_checker"     value="$(arg enable_crosswalk_checker)" />
        <arg name="enable_yielding_checker"      value="$(arg enable_yielding_checker)" />
        <arg name="enable_give_way_checker"      value="$(arg enable_give_way_checker)" />
        <arg name="enable_right_of_way_checker"  value="$(arg enable_right_of_way_checker)" />
        <arg name="enable_trajectory_checker"    value="$(arg enable_trajectory_checker)" />
        <arg name="enable_bus_stop_checker"      value="$(arg enable_bus_stop_checker)" />
        <arg name="enable_road_closures"         value="$(arg enable_road_closures)" />
        <arg name="use_python_visualizers"       value="$(arg use_python_visualizers)" />
    </include>

    <!-- Control -->
    <include if="$(arg use_control)" file="$(find autoware_mini)/launch/control.launch">
        <arg name="controller"            value="$(arg controller)" />
    </include>

    <!-- Bag platform -->
    <include file="$(find autoware_mini)/launch/platform/bag.launch">
        <arg name="use_tf"               value="$(arg use_tf)" />
        <arg name="repub_camera_info"    value="$(arg repub_camera_info)" />
        <arg name="use_nvidia_cameras"   value="$(arg use_nvidia_cameras)" />
        <arg name="nvidia_encoder"       value="$(arg nvidia_encoder)" />
        <arg name="use_ssc"              value="$(arg use_control)" />
    </include>

    <!-- Carla platform -->
    <include if="$(arg use_vil)" file="$(find autoware_mini)/launch/platform/carla.launch">
        <arg name="map_name"          value="$(arg map_name)" />
        <arg name="carla_host"        value="$(arg carla_host)" />
        <arg name="carla_port"        value="$(arg carla_port)" />
        <arg name="use_vil"           value="true" />
        <arg name="use_lidar"         value="$(eval 'lidar' in detector)" />
        <arg name="use_radar"         value="$(eval 'radar' in detector)" />
        <arg name="use_mako_cameras"  value="$(eval ('camera' in tfl_detector or 'yolo' in tfl_detector) and tfl_cameras=='mako')" />
        <arg name="use_nvidia_cameras" value="$(eval ('camera' in tfl_detector or 'yolo' in tfl_detector) and tfl_cameras=='nvidia')" />
        <arg name="publish_clock"     value="false" />
    </include>

    <!-- Monitoring -->
    <include if="$(arg use_monitoring)" file="$(find autoware_mini)/launch/tools/monitoring.launch"> 
        <arg name="use_driver_monitoring" value="$(arg use_driver_monitoring)" />
    </include>

    <!-- Rviz -->
    <include if="$(arg launch_rviz)" file="$(find autoware_mini)/launch/rviz.launch">
        <arg name="carla_status"        value="true" />
    </include>

</launch>