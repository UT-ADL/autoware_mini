<?xml version="1.0"?>
<launch>
    <arg name="carla_status"        default="false"/>
    <arg name="node_name"        default="rviz" />
    <arg name="dashboard"        default="$(eval node_name == 'rviz')" />
    <arg name="respawn"          default="false" />

    <node type="rviz" name="$(arg node_name)" pkg="rviz" args="-d $(find autoware_mini)/config/rviz/autoware_mini.rviz" respawn="$(arg respawn)" required="$(eval not respawn)" launch-prefix="nice -n 15">
        <rosparam command="load" file="$(find autoware_mini)/config/rviz/actions.yaml" />
        <!-- Remap odometry topic for Carla plugin to localization odometry -->
        <remap if="$(arg carla_status)" from="/carla/ego_vehicle/odometry" to="/localization/odometry" />
    </node>

    <!-- Visualize vehicle status in Carla plugin -->
    <node if="$(arg carla_status)" pkg="autoware_mini" type="carla_status_visualizer.py" name="carla_status_visualizer" output="screen" required="true" launch-prefix="nice -n 15" />

    <include if="$(arg dashboard)" file="$(find autoware_mini)/launch/dashboard.launch" />
</launch>