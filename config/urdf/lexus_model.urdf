<?xml version="1.0"?>
<!-- created with Phobos 1.0.1 "Capricious Choutengan" -->
<robot name="lexus">

  <link name="base_link" />

  <link name="lexus_model">
    <visual name="Body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://autoware_mini/config/urdf/lexus_model/Exterior.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
  </link>

  <!-- Lexus Model -->
  <joint name="joint_lexus_model" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lexus_model"/>
  </joint>

</robot>
