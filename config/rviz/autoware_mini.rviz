              Show Axes: false
              Show Trail: false
            lexus_model:
              Alpha: 1
              Show Axes: false
              Show Trail: false
              Value: true
          Name: Lexus model
          Robot Description: lexus_model/robot_description
          TF Prefix: ""
          Update Interval: 0
          Value: true
          Visual Enabled: true
        - Alpha: 0.5
