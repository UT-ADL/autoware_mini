Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Dashboard1/Detailed Diagnostics1
        - /Dashboard1/Additional Diagnostics1
        - /Perception1/Tracked objects (Python)1/Namespaces1
        - /Planning1/Global path1/Namespaces1
      Splitter Ratio: 0.6560846567153931
    Tree Height: 673
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: Collision points
  - Class: rviz_carla_plugin/CarlaControl
    Name: CarlaControl
  - Class: jsk_rviz_plugin/EmptyServiceCallInterfaceAction
    Name: Actions
  - Class: jsk_rviz_plugin/RecordAction
    Name: Record Bags
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
